<Window x:Class="DeskLock.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskLock"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FFF6F7F9"
        Foreground="#FF17202E"
        FontFamily="Segoe UI"
        FontSize="14"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewLostKeyboardFocus="Window_PreviewLostKeyboardFocus"
        PreviewMouseDown="Window_PreviewMouseDown">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="StatusCardButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Height" Value="70" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#FFDDE3EC"
                                    BorderThickness="1"
                                    CornerRadius="12" />
                            <Grid Margin="9,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        Background="{Binding CardBackground}"
                                        CornerRadius="12"
                                        VerticalAlignment="Center">
                                    <Path Data="{Binding IconGeometry}"
                                          Fill="Transparent"
                                          Width="22"
                                          Height="22"
                                          Stretch="Uniform"
                                          Stroke="{Binding Brush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,2,0">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#FF17202E"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="12"
                                               Foreground="#FF465163"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Grid x:Name="SelectionIndicator"
                                      Grid.Column="2"
                                      Width="20"
                                      Height="20"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed">
                                    <Ellipse Fill="#FF0F2A47" />
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                            <Border x:Name="KeyboardFocusRing"
                                    BorderBrush="Transparent"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="KeyboardFocusRing" Property="BorderBrush" Value="#FF0F2A47" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                    <Condition Binding="{Binding IsSelected}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFB8C5D6" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFEAF1FB" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF0F2A47" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimeOptionButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#FF17202E" />
            <Setter Property="BorderBrush" Value="#FFCFD6E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF0F2A47" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF0F2A47" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF0F2A47" />
                                <Setter Property="Foreground" Value="White" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF465163" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <Style x:Key="CustomStatusTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#FF17202E" />
            <Setter Property="BorderBrush" Value="#FFCFD6E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF0F2A47" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LockButton" TargetType="Button">
            <Setter Property="Height" Value="54" />
            <Setter Property="Margin" Value="0,16,0,0" />
            <Setter Property="Background" Value="#FF0F2A47" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#FF0F2A47"
                                BorderThickness="0"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF193B60" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF091F36" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF7087A1" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF465163" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FF0F2A47" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FFDDE3EC" BorderThickness="1" Background="#FFF6F7F9">
        <StackPanel>
            <Border Background="#FF0F2A47" Padding="20,12" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <TextBlock Text="DeskLock" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <StackPanel Margin="18,0,18,18">
                <TextBlock Text="What are you doing?" Style="{StaticResource SectionLabel}" FontSize="16" Margin="0,14,0,8" />
                <ItemsControl x:Name="StatusOptions" ItemsSource="{Binding Statuses}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource StatusCardButton}"
                                    Focusable="True"
                                    Command="{Binding DataContext.SelectStatusCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Name}"
                                    AutomationProperties.HelpText="{Binding Description}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Custom Status" Style="{StaticResource SectionLabel}" />
                <Grid>
                    <TextBox Style="{StaticResource CustomStatusTextBox}"
                             Text="{Binding CustomMessage, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Custom status" />
                    <TextBlock Text="e.g. Visiting a client"
                               Margin="13,0"
                               Foreground="#FF778191"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CustomMessage}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Grid Margin="0,14,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="When you will be back" FontWeight="SemiBold" FontSize="15" Foreground="#FF465163" />
                    <TextBlock Grid.Column="1" Text="{Binding ReturnTimePreview}" FontSize="13" Foreground="#FF465163" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl x:Name="TimeOptions" ItemsSource="{Binding TimeOptions}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TimeOptionButton}"
                                    Content="{Binding Label}"
                                    Focusable="True"
                                    Command="{Binding DataContext.SelectTimeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding ErrorText}"
                           Foreground="#FFC62828"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />

                <Button Command="{Binding LockCommand}" Style="{StaticResource LockButton}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE72E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="19"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <TextBlock Text="Lock screen" VerticalAlignment="Center" />
                        <Border Background="#FF405773" CornerRadius="6" Padding="9,3" Margin="12,0,0,0">
                            <TextBlock Text="Enter" FontSize="12" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Button>

                <Button Content="Cancel (Esc)"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource CancelButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
