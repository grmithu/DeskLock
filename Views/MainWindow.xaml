<Window x:Class="DeskLock.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desk Lock"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FFF7F7F7"
        FontFamily="Segoe UI"
        FontSize="14">

    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding LockCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Shob option button er base style (keyboard focus nei, jate Enter shob shomoy Lock kore) -->
        <Style x:Key="OptionButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="#FFEDEDED" />
            <Setter Property="Foreground" Value="#FF1A1A1A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" MinHeight="40">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Select hole nil -->
        <Style x:Key="SelectableButton" TargetType="Button" BasedOn="{StaticResource OptionButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#FF0078D7" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FF9A9A9A" BorderThickness="1">
        <StackPanel>

            <!-- Header (drag kora jay) -->
            <Border Background="#FF0F2A44" Padding="16,10" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel>
                    <TextBlock Text="Desk Lock" Foreground="White" FontWeight="SemiBold" />
                    <TextBlock Text="Enter = Lock   Esc = Cancel" Foreground="#FFB8C7D9" FontSize="12"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <StackPanel Margin="16,0,16,16">

                <TextBlock Text="Status" Style="{StaticResource SectionLabel}" />
                <ItemsControl ItemsSource="{Binding Statuses}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SelectableButton}"
                                    Command="{Binding DataContext.SelectStatusCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="{Binding Brush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Or type a custom message" Style="{StaticResource SectionLabel}" />
                <TextBox Text="{Binding CustomMessage, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,5" BorderBrush="#FFBBBBBB" />

                <TextBlock Text="Back in" Style="{StaticResource SectionLabel}" />
                <ItemsControl ItemsSource="{Binding TimeOptions}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SelectableButton}"
                                    Content="{Binding Label}"
                                    FontSize="13"
                                    Command="{Binding DataContext.SelectTimeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Or exact time (e.g. 2:00 PM)" Style="{StaticResource SectionLabel}" />
                <TextBox Text="{Binding ExactTime, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,5" BorderBrush="#FFBBBBBB" />

                <TextBlock Text="{Binding ErrorText}" Foreground="#FFC62828" TextWrapping="Wrap" Margin="0,10,0,0" />

                <Button Content="Lock now" Command="{Binding LockCommand}"
                        Margin="0,12,0,0" Height="52" FontSize="16" FontWeight="SemiBold"
                        Foreground="White" Background="#FF107C10" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="Cancel (Esc)" Command="{Binding CancelCommand}"
                        Margin="0,8,0,0" Height="30" Focusable="False"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
